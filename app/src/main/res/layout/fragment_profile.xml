<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:layout_gravity="end"
            android:padding="12dp"/>
    </androidx.appcompat.widget.Toolbar>

    <!-- Аватар -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/Avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/profile_icon_accessibility_description"
        android:src="@drawable/circle_gray"
        android:scaleType="centerCrop"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:shapeAppearanceOverlay="@style/CircleImage"/>

    <!-- Email (только просмотр) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/email_title"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/emailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/email_placeholder"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/bg_card"/>

    <!-- ФИО (редактирование) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/name_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/fullNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="name"
        android:hint="@string/name_placeholder"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:maxLines="1"/>

    <!-- Дата рождения (редактирование, формат ДД.ММ.ГГГГ) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/birthdate_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/birthDateInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="birth_date"
        android:hint="@string/birthdate_hint"
        android:inputType="date"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:maxLength="10"
        android:maxLines="1"
        android:digits="0123456789."/>

    <!-- Паспорт (редактирование, перемещён выше кнопки) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/id_number_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/passportInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="id_card"
        android:hint="@string/id_number_hint"
        android:inputType="textNoSuggestions"
        android:padding="12dp"
        android:background="@drawable/bg_card"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/passportHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/id_number_notation"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:textColor="@android:color/darker_gray"/>

    <!-- Кнопка сохранения (теперь внизу) -->
    <Button
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:text="@string/profile_save_changes_button_label"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/design_default_color_primary"
        android:textColor="@android:color/white"/>

    <!-- ProgressBar и Error -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone"/>

    <!-- Кнопка выхода (в самом низу) -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:text="@string/logout_button_label"
        android:textColor="@android:color/white" />

</LinearLayout>